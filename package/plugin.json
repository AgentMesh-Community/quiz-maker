  "author": {
    "name": "Agent Builder"
  },
  "keywords": [
    "built-agent",
    "draft",
    "make-a-quiz",
    "read-the-source",
    "name-the-concepts",
    "write-the-questions",
    "check-the-questions",
    "stage-the-quiz"
  ],
  "extensions": {
    "net.agentdoc.package": {
      "descriptor": {
        "path": "descriptor.json",
